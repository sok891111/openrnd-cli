# ============================================================
# openwork CLI - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Local LLM (Ollama) - Default provider ----------------
# Ollama: install from https://ollama.ai, then run: ollama pull llama3.2
OPENWORK_BASE_URL=http://localhost:11434/v1
OPENWORK_API_KEY=ollama
OPENWORK_MODEL=llama3.2

# ---- LM Studio ─────────────────────────────────────────────
# OPENWORK_BASE_URL=http://localhost:1234/v1
# OPENWORK_API_KEY=lm-studio
# OPENWORK_MODEL=local-model

# ---- OpenAI compatible (vLLM, llama.cpp server, etc.) -----
# OPENWORK_BASE_URL=http://localhost:8000/v1
# OPENWORK_API_KEY=your-key
# OPENWORK_MODEL=your-model-name

# ---- Vision model (for image analysis) --------------------
# The primary model above may be a high-performance *text-only* model that
# cannot read images. Configure a separate vision-capable model here; when a
# request contains images, they are sent to this model and replaced with a
# text description before being forwarded to the primary model.
# Preferred config is settings.json (llm.vision.{baseUrl,model,apiKey}); these
# env vars override it. Leave unset to disable (images are then ignored).
# OPENWORK_VISION_BASE_URL=http://localhost:11434/v1
# OPENWORK_VISION_MODEL=llava
# OPENWORK_VISION_API_KEY=ollama

# ---- Trust workspace for headless/non-interactive mode ----
OPENWORK_TRUST_WORKSPACE=true

# ---- In-house LLM rate limit (RPM) handling ----------------
# ON by default: a rate-limited (HTTP 429 / "too many requests") LLM request
# waits a full reset window (60s) before retrying, instead of the short
# exponential backoff (which keeps hammering a per-minute quota and looks like
# a hang). Override the window below (seconds), or set 0 to disable and fall
# back to exponential backoff. Default when unset = 60 (wait 1 minute, retry).
# OPENWORK_RATE_LIMIT_RETRY_SECONDS=60

# ---- Google Gemini API (optional fallback) ----------------
# GEMINI_API_KEY=your-gemini-api-key

# ---- MCP Server configuration (in ~/.openwork/settings.json)
# See docs/mcp-configuration.md for details
